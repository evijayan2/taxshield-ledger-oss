# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL Connection URL
# For Local Development:
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/taxledger"
# LOCAL_POSTGRES_URL="postgres://postgres:postgres@localhost:5432/taxledger"

# For Vercel Postgres / Production:
# POSTGRES_URL="postgres://default:***@ep-***.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_URL=
DATABASE_URL=
LOCAL_POSTGRES_URL=

# Email Provider Configuration (options: 'console', 'resend', 'sendgrid', 'smtp')
# Default is 'console' which safely logs emails to stdout for local development.
EMAIL_PROVIDER=console
EMAIL_FROM="TaxShield Ledger <noreply@taxshield.local>"

# Resend:
# RESEND_API_KEY=re_...

# SendGrid:
# SENDGRID_API_KEY=SG....

# SMTP / Local Mail Server:
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Tax Rule Package Distribution Server (Module 1)
# Local development default:
TAXPACK_SERVER_URL="http://localhost:3333"
TAX_PACKAGE_SERVER_URL="http://localhost:3333"
# Production (Vercel): configured via GitHub Actions / Vercel Environment Variables:
# TAXPACK_SERVER_URL="https://tax-rule-packaging-engine.vercel.app"
# TAX_PACKAGE_SERVER_URL="https://tax-rule-packaging-engine.vercel.app"



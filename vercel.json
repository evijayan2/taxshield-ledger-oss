{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "dist",
  "installCommand": "node scripts/ensure-shared-core.cjs && (corepack enable pnpm || true) && (pnpm install --no-frozen-lockfile || npm install)",
  "buildCommand": "pnpm build || npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

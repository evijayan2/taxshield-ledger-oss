# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL Connection URL
# For Local Development:
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/taxledger"
# LOCAL_POSTGRES_URL="postgres://postgres:postgres@localhost:5432/taxledger"

# For Vercel Postgres / Production:
# POSTGRES_URL="postgres://default:***@ep-***.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_URL=
DATABASE_URL=
LOCAL_POSTGRES_URL=

# Optional Firebase Web Client Overrides
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
